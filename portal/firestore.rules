rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function member(w) { return request.auth != null && request.auth.token.email_verified == true && get(/databases/$(database)/documents/workspaces/$(w)/members/$(request.auth.uid)).data.active == true; }
  function editor(w) { return member(w) && get(/databases/$(database)/documents/workspaces/$(w)/members/$(request.auth.uid)).data.role in ['admin','editor']; }
  function stamped() { return request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time; }
  match /workspaces/{w}/members/{uid} {
   allow get: if request.auth != null && request.auth.uid == uid;
   allow list, write: if false;
  }
  match /workspaces/{w}/clients/{c} {
   allow read: if member(w);
   allow create, update: if editor(w) && stamped()
     && request.resource.data.keys().hasOnly(['name','website','tone','colours','status','updatedAt','updatedBy'])
     && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120
     && request.resource.data.website is string && request.resource.data.website.size() <= 500
     && request.resource.data.tone is string && request.resource.data.tone.size() <= 5000
     && request.resource.data.colours is list && request.resource.data.colours.size() <= 20
     && request.resource.data.status == 'onboarding';
   match /assets/{id} {
    allow read: if member(w);
    allow create: if editor(w)
      && request.resource.data.keys().hasOnly(['name','category','objectPath','contentType','size','createdAt','createdBy'])
      && request.resource.data.name is string && request.resource.data.name.size() <= 255
      && request.resource.data.category in ['Logo','Brand guidelines','Imagery']
      && request.resource.data.objectPath == 'workspaces/'+w+'/clients/'+c+'/assets/'+id
      && request.resource.data.contentType in ['image/png','image/jpeg','image/webp','application/pdf']
      && request.resource.data.size <= 20*1024*1024 && request.resource.data.size > 0
      && request.resource.data.createdBy == request.auth.uid && request.resource.data.createdAt == request.time;
   }
   match /posts/{id} {
    allow read: if member(w);
    function valid() { return stamped() && request.resource.data.keys().hasOnly(['text','platform','assetId','status','createdBy','updatedBy','updatedAt']) && request.resource.data.text is string && request.resource.data.text.size()>0 && request.resource.data.text.size()<=2200 && request.resource.data.platform in ['facebook','instagram'] && (!('assetId' in request.resource.data) || request.resource.data.assetId == null || (request.resource.data.assetId is string && request.resource.data.assetId.matches('^[A-Za-z0-9_-]{1,128}$'))); }
    allow create: if editor(w) && valid() && request.resource.data.status=='draft' && request.resource.data.createdBy==request.auth.uid;
    allow update: if editor(w) && valid() && (!exists(/databases/$(database)/documents/workspaces/$(w)/publishJobs/$(c+'_'+id)) || get(/databases/$(database)/documents/workspaces/$(w)/publishJobs/$(c+'_'+id)).data.status == 'cancelled') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedBy','updatedAt']) && (
      (resource.data.status=='draft' && request.resource.data.status=='pending_approval') ||
      (resource.data.status=='pending_approval' && request.resource.data.status in ['approved','draft']) ||
      (resource.data.status=='approved' && request.resource.data.status=='draft'));
   }
  }
  match /workspaces/{w}/activity/{id} {
   allow read: if member(w);
   allow create: if editor(w) && request.resource.data.keys().hasOnly(['actor','clientId','action','targetId','createdAt']) && request.resource.data.actor==request.auth.uid && request.resource.data.createdAt==request.time && request.resource.data.clientId is string && request.resource.data.targetId is string && request.resource.data.action in ['client.created','client.updated','asset.uploaded','post.created','post.pending_approval','post.approved','post.draft'];
  }
 }
}
