{
  "name": "human-standard-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "test": "node --test tests/*.test.js",
    "test:rules": "node node_modules/firebase-tools/lib/bin/firebase.js emulators:exec --only firestore --project demo-human-standard \"node tests/access.rules.js\"",
    "test:storage": "node node_modules/firebase-tools/lib/bin/firebase.js emulators:exec --only firestore,storage --project demo-human-standard \"node tests/storage.rules.js\"",
    "test:queue": "node node_modules/firebase-tools/lib/bin/firebase.js emulators:exec --only firestore --project demo-human-standard \"node tests/queue.integration.mjs\""
  },
  "dependencies": {
    "firebase": "^12.0.0",
    "firebase-admin": "^13.10.0",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase-tools": "^14.27.0"
  }
}
